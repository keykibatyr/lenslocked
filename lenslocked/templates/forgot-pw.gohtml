{{template "header" .}}
<div class = "py-12 flex justify-center">
    <div class = "px-8 py-8 bg-white rounded shadow">
        <h1 class = "pt-4 pb-8 text-center text-3xl font-bald text-gray-900">
            Forgot ypur password?
            </h1>
            <p class = "text-sm text-gray-600 pb-4">
                No problem. Enter your email address below and we will sed you a link to reset 
                your password
            </p>
        <form action = "/forgot-pw" method = "post" enctype = "multipart/form-data">
            {{csrfField}}
            <div>
                <label for = "email" class = "text-sm font-semibold text-gray-800">Email Address</label>
                <input name = "email" id = "email" type= "email" placeholder="Email Address"
                required autocomplete="email" class = "w-full px-3 py-2 border border-gray-300 
                placeholder-gray-500 text-gray-800 rounded" value = "{{.Email}}" autofocus/>
            </div>
            <div class="py-4">
                <button type = "submit" class = "py-4 px-2 w-full
                bg-indigo-600 text-white rounded 
                font-bold text-lg hover:bg-indigo-700">Reset Password</button>
            <div class = "flex justify-between w-full py-2">
                <p class = "text-s text-gray-500">Don't have an account? <a class = "underline" href = "/signUp">Sign Up</a></p>
                <p class = "text-s text-gray-500"><a class = "underline" href = "/signIn">Remember your Password?</a></p>
            </div>
            </div>
        </form>
    </div>
</div>
{{template "footer" .}}