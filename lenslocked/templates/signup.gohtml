{{template "header" .}}
<div class = "py-12 flex justify-center">
    <div class = "px-8 py-8 bg-white rounded shadow">
        <h1 class = "pt-4 pb-8 text-center text-3xl font-bald text-gray-900">
            Start sharing your photos today
            </h1>
        <form action = "/signUp" method = "post" enctype = "multipart/form-data">
            {{csrfField}}
            <div>
                <label for = "email" class = "text-sm font-semibold text-gray-800">Email Address</label>
                <input name = "email" id = "email" type= "email" placeholder="Email Address"
                required autocomplete="email" class = "w-full px-3 py-2 border border-gray-300 
                placeholder-gray-500 text-gray-800 rounded" value = "{{.Email}}"  {{if not .Email}}autofocus{{end}}/>
            </div>
            <div>
                <label for = "password" class = "text-sm font-semibold text-gray-800">Password</label>
                <input name = "password" id = "password" type = "password" placeholder="Password" required 
                class = "w-full px-3 py-2 border border-gray-300 
                placeholder-gray-500 text-gray-800 rounded" {{if .Email}}autofocus{{end}} />
            </div>
            <div class="pt-4">
                <label for="profile_picture" class = "text-sm font-semibold text-gray-800">Profile Picture:   </label>
                <input type = "file" id="profile_picture" name="profile_picture">
            </div>
            <div class="pt-4">
                <input type = "checkbox" id = "checkbox" name = "checkbox1" value = "agreed" required>
                <label for="checkbox1" class = "text-sm font-semibold text-gray-800"> I agree to terms & conditions </label><br>
            </div>
            <div class="py-4">
                <button type = "submit" class = "py-4 px-2 w-full
                bg-indigo-600 text-white rounded 
                font-bold text-lg hover:bg-indigo-700">Sign Up</button>
            <div class = "flex justify-between w-full py-2">
                <p class = "text-s text-gray-500">Already have an account? <a class = "underline" href = "/signIn">Sign in</a></p>
                <p class = "text-s text-gray-500"><a class = "underline" href = "/forgot-pw">Forgot the password?</a></p>
            </div>
            </div>
        </form>
    </div>
</div>
{{template "footer" .}}