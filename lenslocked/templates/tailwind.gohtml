{{define "header"}}
<!doctype html>
<html>
<head>
  <!-- ... -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://unpkg.com/tailwindcss@^2/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="flex flex-col min-h-screen justify-between bg-gray-200"  >
  <header class = "bg-gradient-to-r from-blue-800 to-indigo-900">
    <nav class = "px-8 py-6 flex items-center text-white ">
      <div class = "text-4xl pr-8 font-serif">Lenslocked</div>

      <div class = "flex-grow pl-7">
        <a class = "text-lg font-semibold hover: text-blue-100 pr-8" href = "/"> Home </a>
        <a class = "text-lg font-semibold hover: text-blue-100 pr-8" href = "/contact"> Contact </a>
        <a class = "text-lg font-semibold hover: text-blue-100 pr-8" href = "/faq"> FAQ </a>
      </div>

      <div>
        <a class="pr-8" href = "/signIn"> Sign in </a>
        <a class="pr-4 px-4 py-2 bg-blue-700 hover:bg-blue-600 rounded" href = "/signUp"> Sign up </a>
      </div>
    </nav>
  </header>
{{end}}
  <!-- ... -->

{{define "footer"}}
<footer class="bg-blue-500 text-lg">
 @Lenslocked; Alisher Temirgali | <a class = "underline" href="https://youtu.be/dQw4w9WgXcQ?si=AGnhGeksiJ89B8kU">My LinkedIn</a>
</footer>
</body>
</html>
{{end}}